{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/agent_execution_result.v1.schema.json",
  "title": "Quantify agent-execution result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "task_id", "plan_id", "plan_request_hash", "status", "artifacts", "unavailable_reason", "limitations"],
  "properties": {
    "schema_version": { "const": "agent-execution-result.v1" },
    "execution_id": { "type": "string", "pattern": "^agent-execution-[a-f0-9]{32}$" },
    "task_id": { "$ref": "#/$defs/id" },
    "plan_id": { "type": "string", "pattern": "^agent-plan-[a-f0-9]{32}$" },
    "plan_request_hash": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["completed", "requires_review", "unavailable"] },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "unavailable_reason": {
      "type": ["string", "null"],
      "enum": ["plan_unavailable", "policy_unavailable", "tool_unavailable", "required_input_unavailable", "required_data_unavailable", "verifier_unavailable", null]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "unavailable" } } },
      "then": { "properties": { "unavailable_reason": { "type": "string" } } },
      "else": { "properties": { "unavailable_reason": { "const": null } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "tool_name", "request_hash", "result_hash", "dependency_result_hashes", "status", "statement_ids", "citation_ids", "claim_ids"],
      "properties": {
        "stage_id": { "$ref": "#/$defs/id" },
        "tool_name": { "enum": ["verify_claims", "search_approved_evidence_release", "calculate_approved_evidence", "create_review_task", "narrative_context"] },
        "request_hash": { "$ref": "#/$defs/hash" },
        "result_hash": { "$ref": "#/$defs/hash" },
        "dependency_result_hashes": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "status": { "enum": ["completed", "partial", "unavailable", "requires_review"] },
        "statement_ids": { "$ref": "#/$defs/ids" },
        "citation_ids": { "$ref": "#/$defs/ids" },
        "claim_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
