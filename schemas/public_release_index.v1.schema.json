{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/public_release_index.v1.schema.json",
  "title": "Quantify public release index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "releases"],
  "properties": {
    "schema_version": { "const": "public-release-index.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog", "status", "release_id", "manifest_hash", "observed_at", "freshness", "limitations"],
        "properties": {
          "catalog": {
            "enum": ["investors", "markets", "macro", "rates", "etf_flows", "crypto", "crypto_exposure", "earnings", "policy", "events"]
          },
          "status": { "enum": ["available", "unavailable", "source_review", "revoked"] },
          "release_id": { "type": ["string", "null"] },
          "manifest_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "observed_at": { "type": ["string", "null"], "format": "date-time" },
          "freshness": { "enum": ["current", "stale", "not_applicable", "unknown"] },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "available" } } },
            "then": {
              "properties": {
                "release_id": { "type": "string", "minLength": 1 },
                "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "observed_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        ]
      }
    }
  }
}
