{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/approved_calculation_result.v1.schema.json",
  "title": "Quantify approved deterministic calculation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_hash",
    "evidence_search_result_hash",
    "release_manifest_hash",
    "status",
    "calculations",
    "limitation"
  ],
  "properties": {
    "schema_version": { "const": "approved-calculation-result.v1" },
    "request_hash": { "$ref": "#/$defs/sha256" },
    "evidence_search_result_hash": { "$ref": "#/$defs/sha256" },
    "release_manifest_hash": { "$ref": "#/$defs/sha256" },
    "status": { "const": "completed" },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/calculation_statement" }
    },
    "limitation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "fact_statement_id": {
      "type": "string",
      "pattern": "^fact-[a-f0-9]{64}$"
    },
    "calculation_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "kind",
        "text",
        "citation_ids",
        "derived_from_statement_ids",
        "measurement",
        "calculation"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "pattern": "^calc-[A-Za-z0-9._:-]+$"
        },
        "kind": { "const": "deterministic_calculation" },
        "text": { "type": "string", "minLength": 1 },
        "citation_ids": {
          "type": "array",
          "maxItems": 0
        },
        "derived_from_statement_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fact_statement_id" }
        },
        "measurement": { "type": "null" },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "inputs", "value", "unit", "decimal_places"],
          "properties": {
            "operation": {
              "enum": ["sum", "difference", "percent_change", "percentage_point_change"]
            },
            "inputs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["statement_id"],
                "properties": {
                  "statement_id": { "$ref": "#/$defs/fact_statement_id" }
                }
              }
            },
            "value": { "$ref": "#/$defs/decimal" },
            "unit": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_./-]{0,31}$"
            },
            "decimal_places": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            }
          }
        }
      }
    }
  }
}
