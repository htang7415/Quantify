{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/agent_plan_result.v1.schema.json",
  "title": "Quantify agent-plan result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "task_id", "request_hash", "proposal_hash", "task_intent", "status", "stages", "unavailable_reason", "limitations"],
  "properties": {
    "schema_version": { "const": "agent-plan-result.v1" },
    "plan_id": { "type": "string", "pattern": "^agent-plan-[a-f0-9]{32}$" },
    "task_id": { "$ref": "#/$defs/id" },
    "request_hash": { "$ref": "#/$defs/hash" },
    "proposal_hash": { "$ref": "#/$defs/hash" },
    "task_intent": { "enum": ["explore", "analyze", "compare", "verify"] },
    "status": { "enum": ["planned", "unavailable"] },
    "stages": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/stage" }
    },
    "unavailable_reason": {
      "type": ["string", "null"],
      "enum": ["unsupported_question", "insufficient_scope", "no_permitted_tools", "prohibited_request", null]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "planned" } } },
      "then": {
        "properties": {
          "stages": { "minItems": 1 },
          "unavailable_reason": { "const": null }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "unavailable" } } },
      "then": {
        "properties": {
          "stages": { "maxItems": 0 },
          "unavailable_reason": { "type": "string" }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "tool_name", "purpose", "depends_on_stage_ids"],
      "properties": {
        "stage_id": { "$ref": "#/$defs/id" },
        "tool_name": { "enum": ["verify_claims", "search_approved_evidence_release", "calculate_approved_evidence", "create_review_task", "narrative_context"] },
        "purpose": { "enum": ["retrieve_facts", "calculate", "retrieve_context", "verify_claim", "route_review"] },
        "depends_on_stage_ids": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
