{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/policy_event_catalog.v1.schema.json",
  "title": "Quantify policy event catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "manifest_hash", "source_record_hash", "observed_at", "retrieved_at", "scope", "methodology", "limitations", "events"],
  "properties": {
    "schema_version": { "const": "policy-event-catalog.v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "events": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "category", "authority_id", "authority_name", "title", "action_type", "status", "published_at", "effective_at", "source_document_id", "source_url", "source_sha256", "details"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "enum": ["monetary_policy", "financial_regulation", "trade_export_controls"] },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "action_type": { "enum": ["decision", "final_rule"] },
        "status": { "enum": ["active", "scheduled_effective"] },
        "published_at": { "type": "string", "format": "date" },
        "effective_at": { "type": "string", "format": "date" },
        "source_document_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://(www\\.federalreserve\\.gov|www\\.sec\\.gov|www\\.federalregister\\.gov)/" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "details": {
          "oneOf": [
            { "$ref": "#/$defs/fomc" },
            { "$ref": "#/$defs/jointStandards" },
            { "$ref": "#/$defs/exportRule" }
          ]
        }
      }
    },
    "fomc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision", "target_range_low_pct", "target_range_high_pct", "vote_for", "vote_against", "implementation_source_url", "implementation_source_sha256", "next_meeting_start", "next_meeting_end", "calendar_source_url", "calendar_source_sha256"],
      "properties": {
        "kind": { "const": "fomc_decision" },
        "decision": { "const": "maintained" },
        "target_range_low_pct": { "type": "number", "minimum": 0, "maximum": 20 },
        "target_range_high_pct": { "type": "number", "minimum": 0, "maximum": 20 },
        "vote_for": { "type": "integer", "minimum": 1 },
        "vote_against": { "type": "integer", "minimum": 0 },
        "implementation_source_url": { "type": "string", "format": "uri" },
        "implementation_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "next_meeting_start": { "type": "string", "format": "date" },
        "next_meeting_end": { "type": "string", "format": "date" },
        "calendar_source_url": { "type": "string", "format": "uri" },
        "calendar_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "jointStandards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rule_type", "release_numbers", "federal_register_publish_date", "reporting_requirements_change_at_effective_date", "agencies", "standard_domains"],
      "properties": {
        "kind": { "const": "joint_data_standards" },
        "rule_type": { "const": "final" },
        "release_numbers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "federal_register_publish_date": { "type": "string", "format": "date" },
        "reporting_requirements_change_at_effective_date": { "const": false },
        "agencies": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string", "minLength": 1 } },
        "standard_domains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "exportRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rule_type", "federal_register_citation", "review_policy_before", "review_policy_after", "destinations", "named_products", "related_company_tickers", "conditions"],
      "properties": {
        "kind": { "const": "advanced_computing_export_rule" },
        "rule_type": { "const": "final" },
        "federal_register_citation": { "type": "string", "minLength": 1 },
        "review_policy_before": { "const": "presumption_of_denial" },
        "review_policy_after": { "const": "case_by_case_if_conditions_met" },
        "destinations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "named_products": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "related_company_tickers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]{1,5}$" } },
        "conditions": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "enum": ["commercial_availability", "us_supply_capacity", "recipient_security_procedures", "independent_us_testing"] } }
      }
    }
  }
}
