{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/vc_compilation_record.v1.schema.json",
  "title": "Quantify venture compilation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest_sha256", "source_created_at", "compiler_contract", "catalog_release_id", "catalog_manifest_hash", "firm_count", "relationship_count", "publication_authorized"],
  "properties": {
    "schema_version": { "const": "vc-compilation-record.v1" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_created_at": { "type": "string", "format": "date-time" },
    "compiler_contract": { "const": "build-vc-catalog.v1" },
    "catalog_release_id": { "type": "string", "minLength": 1 },
    "catalog_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "firm_count": { "type": "integer", "minimum": 1 },
    "relationship_count": { "type": "integer", "minimum": 0 },
    "publication_authorized": { "const": false }
  }
}
