{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/investor_compilation_record.v1.schema.json",
  "title": "Quantify investor compilation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest_sha256",
    "source_created_at",
    "security_metadata_sha256",
    "compiler_contract",
    "quarters",
    "resource_count",
    "catalog_release_id",
    "catalog_manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "investor-compilation-record.v1" },
    "source_manifest_sha256": { "$ref": "#/$defs/hash" },
    "source_created_at": { "type": "string", "format": "date-time" },
    "security_metadata_sha256": { "$ref": "#/$defs/hash" },
    "compiler_contract": { "const": "investor-catalog.v1" },
    "quarters": { "type": "integer", "minimum": 2, "maximum": 8 },
    "resource_count": { "type": "integer", "minimum": 1 },
    "catalog_release_id": { "type": "string", "pattern": "^13f-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$" },
    "catalog_manifest_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
