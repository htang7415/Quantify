{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/approved_review_task_result.v1.schema.json",
  "title": "Quantify approved review task result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_hash",
    "review_task_id",
    "status",
    "task_type",
    "review_origin",
    "reason",
    "question",
    "release",
    "policy",
    "source_result_hashes",
    "derived_from_statement_ids",
    "derived_from_citation_ids",
    "audit_manifest_hash",
    "limitation"
  ],
  "properties": {
    "schema_version": { "const": "approved-review-task-result.v1" },
    "request_hash": { "$ref": "#/$defs/sha256" },
    "review_task_id": {
      "type": "string",
      "pattern": "^review-[a-f0-9]{32}$"
    },
    "status": { "const": "requires_review" },
    "task_type": { "enum": ["explore", "analyze", "compare", "verify"] },
    "review_origin": {
      "enum": [
        "bounded_agent",
        "deterministic_validator",
        "deterministic_verifier",
        "policy_control"
      ]
    },
    "reason": {
      "enum": [
        "ambiguous_evidence",
        "conflicting_evidence",
        "missing_required_evidence",
        "interpretation_requires_review",
        "verification_requires_agent_resolution",
        "publication_policy_requires_review"
      ]
    },
    "question": { "type": "string", "minLength": 2, "maxLength": 500 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_hash"],
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_policy_bundle_hash", "release_gate_policy_hash"],
      "properties": {
        "runtime_policy_bundle_hash": { "$ref": "#/$defs/sha256" },
        "release_gate_policy_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_result_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "derived_from_statement_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "derived_from_citation_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "audit_manifest_hash": { "$ref": "#/$defs/sha256" },
    "limitation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    }
  }
}
