{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/public_intelligence_sources.v1.schema.json",
  "title": "Quantify public intelligence source register v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "sources"],
  "properties": {
    "schema_version": { "const": "public-intelligence-sources.v1" },
    "reviewed_at": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "status", "permitted_use", "terms_url", "notes"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["approved", "blocked_public_display", "blocked_commercial_use", "license_required"] },
          "permitted_use": { "type": "string", "minLength": 1 },
          "terms_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
