{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/etf_holdings_catalog.v1.schema.json",
  "title": "Quantify ETF holdings catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "manifest_hash", "source_record_hash", "flow_release_id", "flow_manifest_hash", "security_metadata_hash", "dataset_period", "dataset_url", "dataset_sha256", "dataset_published_at", "retrieved_at", "observed_at", "fresh_until", "selection_rule", "scope", "methodology", "limitations", "funds"],
  "properties": {
    "schema_version": {"const": "etf-holdings-catalog.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "flow_release_id": {"type": "string", "minLength": 1},
    "flow_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "security_metadata_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_period": {"type": "string", "pattern": "^[0-9]{4}Q[1-4]$"},
    "dataset_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.sec\\.gov/"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_published_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "fresh_until": {"type": "string", "format": "date-time"},
    "selection_rule": {"const": "top_10_by_filed_percentage_desc"},
    "scope": {"type": "string", "minLength": 1},
    "methodology": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "funds": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/fund"}}
  },
  "$defs": {
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "holding_id", "issuer_name", "issuer_title", "cusip", "ticker", "theme", "balance", "unit", "currency_code", "currency_value", "filed_percentage", "investment_country"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 10},
        "holding_id": {"type": "string", "minLength": 1},
        "issuer_name": {"type": "string", "minLength": 1},
        "issuer_title": {"type": "string", "minLength": 1},
        "cusip": {"type": "string", "minLength": 9, "maxLength": 9},
        "ticker": {"type": ["string", "null"]},
        "theme": {"type": ["string", "null"]},
        "balance": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "currency_code": {"type": "string", "minLength": 3, "maxLength": 3},
        "currency_value": {"type": "number", "minimum": 0},
        "filed_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "investment_country": {"type": "string", "minLength": 2, "maxLength": 2}
      }
    },
    "fund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fund_id", "ticker", "slug", "name", "accession", "filed_date", "report_date", "net_assets_usd", "total_holding_rows", "published_holding_rows", "top_ten_concentration_pct", "holdings", "source_url"],
      "properties": {
        "fund_id": {"type": "string", "minLength": 1},
        "ticker": {"enum": ["VGT", "QQQ", "SMH"]},
        "slug": {"enum": ["vgt", "qqq", "smh"]},
        "name": {"type": "string", "minLength": 1},
        "accession": {"type": "string", "minLength": 1},
        "filed_date": {"type": "string", "format": "date"},
        "report_date": {"type": "string", "format": "date"},
        "net_assets_usd": {"type": "number", "minimum": 0},
        "total_holding_rows": {"type": "integer", "minimum": 10},
        "published_holding_rows": {"const": 10},
        "top_ten_concentration_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "holdings": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/holding"}},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.sec\\.gov/"}
      }
    }
  }
}
