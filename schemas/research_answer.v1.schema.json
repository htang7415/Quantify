{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/research_answer.v1.schema.json",
  "title": "Quantify grounded research answer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_type",
    "status",
    "as_of",
    "entities",
    "release_scope",
    "answer",
    "answer_statement_ids",
    "statements",
    "citations",
    "counterpoint_statement_ids",
    "unavailable",
    "limitations",
    "model_contract",
    "verification_results",
    "audit_manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "research-answer.v1" },
    "task_type": { "enum": ["explore", "analyze", "compare"] },
    "status": { "enum": ["completed", "requires_review", "unavailable"] },
    "as_of": { "type": "string", "format": "date-time" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "release_scope": { "$ref": "#/$defs/release_scope" },
    "answer": { "type": "string", "minLength": 1 },
    "answer_statement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statement" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "counterpoint_statement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
    },
    "unavailable": {
      "type": "array",
      "items": { "$ref": "#/$defs/unavailable_item" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_contract": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/model_contract" }
      ]
    },
    "verification_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/verification_result" }
    },
    "audit_manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "display_name"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "entity_type": {
          "enum": [
            "company",
            "investor",
            "fund",
            "security",
            "policy_authority",
            "market"
          ]
        },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "release_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogs", "release_ids", "manifest_hashes", "observed_through"],
      "properties": {
        "catalogs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "investors",
              "venture",
              "markets",
              "macro",
              "rates",
              "etf_flows",
              "etf_holdings",
              "crypto",
              "crypto_exposure",
              "earnings",
              "policy",
              "events"
            ]
          }
        },
        "release_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "manifest_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "observed_through": { "type": "string", "format": "date-time" }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "kind",
        "text",
        "citation_ids",
        "derived_from_statement_ids",
        "measurement",
        "calculation"
      ],
      "properties": {
        "statement_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "kind": {
          "enum": [
            "released_fact",
            "deterministic_calculation",
            "agent_interpretation",
            "narrative_context",
            "open_question"
          ]
        },
        "text": { "type": "string", "minLength": 1 },
        "citation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
        },
        "derived_from_statement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
        },
        "measurement": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/measurement" }
          ]
        },
        "calculation": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/calculation" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "released_fact" } } },
          "then": {
            "properties": {
              "citation_ids": { "minItems": 1 },
              "derived_from_statement_ids": { "maxItems": 0 },
              "calculation": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "deterministic_calculation" } } },
          "then": {
            "properties": {
              "derived_from_statement_ids": { "minItems": 1 },
              "citation_ids": { "maxItems": 0 },
              "measurement": { "type": "null" },
              "calculation": { "$ref": "#/$defs/calculation" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "agent_interpretation" } } },
          "then": {
            "properties": {
              "derived_from_statement_ids": { "minItems": 1 },
              "citation_ids": { "maxItems": 0 },
              "measurement": { "type": "null" },
              "calculation": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "narrative_context" } } },
          "then": {
            "properties": {
              "citation_ids": { "minItems": 1 },
              "derived_from_statement_ids": { "maxItems": 0 },
              "measurement": { "type": "null" },
              "calculation": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "open_question" } } },
          "then": {
            "properties": {
              "citation_ids": { "maxItems": 0 },
              "measurement": { "type": "null" },
              "calculation": { "type": "null" }
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "inputs", "value", "unit", "decimal_places"],
      "properties": {
        "operation": {
          "enum": ["sum", "difference", "percent_change", "percentage_point_change"]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement_id"],
            "properties": {
              "statement_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" }
            }
          }
        },
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": { "type": "string", "minLength": 1 },
        "decimal_places": { "type": "integer", "minimum": 0, "maximum": 12 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_type",
        "verification_role",
        "release_manifest_hash",
        "source_record_id",
        "source_url",
        "evidence_id",
        "chunk_hash",
        "source_span"
      ],
      "properties": {
        "citation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "source_type": { "enum": ["structured_fact", "narrative_disclosure", "licensed_news"] },
        "verification_role": { "enum": ["verdict_evidence", "context_only"] },
        "release_manifest_hash": { "$ref": "#/$defs/sha256" },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "evidence_id": { "type": ["string", "null"] },
        "chunk_hash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "source_span": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/source_span" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source_type": { "const": "structured_fact" } } },
          "then": {
            "properties": {
              "verification_role": { "const": "verdict_evidence" },
              "evidence_id": { "type": "string", "minLength": 1 },
              "chunk_hash": { "type": "null" },
              "source_span": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "source_type": { "const": "narrative_disclosure" } } },
          "then": {
            "properties": {
              "verification_role": { "const": "context_only" },
              "evidence_id": { "type": "null" },
              "chunk_hash": { "$ref": "#/$defs/sha256" },
              "source_span": { "$ref": "#/$defs/source_span" }
            }
          }
        },
        {
          "if": { "properties": { "source_type": { "const": "licensed_news" } } },
          "then": {
            "properties": {
              "verification_role": { "const": "context_only" },
              "evidence_id": { "type": "null" },
              "chunk_hash": { "$ref": "#/$defs/sha256" },
              "source_span": { "$ref": "#/$defs/source_span" }
            }
          }
        }
      ]
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_char", "end_char"],
      "properties": {
        "start_char": { "type": "integer", "minimum": 0 },
        "end_char": { "type": "integer", "minimum": 1 }
      }
    },
    "unavailable_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "reason", "detail"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "reason": {
          "enum": [
            "not_released",
            "out_of_scope",
            "not_entitled",
            "stale",
            "revoked",
            "unavailable"
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "prompt_contract_hash",
        "tool_contract_hash",
        "provider_attempt_id"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "prompt_contract_hash": { "$ref": "#/$defs/sha256" },
        "tool_contract_hash": { "$ref": "#/$defs/sha256" },
        "provider_attempt_id": { "type": "string", "minLength": 1 }
      }
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "verdict",
        "authority",
        "evidence_scope_manifest_hash",
        "audit_manifest_hash"
      ],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "verdict": {
          "enum": [
            "verified",
            "unsupported",
            "defeated",
            "qualified",
            "requires_agent_resolution"
          ]
        },
        "authority": { "const": "deterministic_verifier" },
        "evidence_scope_manifest_hash": { "$ref": "#/$defs/sha256" },
        "audit_manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
