{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/approved_evidence_search_request.v1.schema.json",
  "title": "Quantify approved evidence search request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_type", "entity", "as_of", "release", "queries"],
  "properties": {
    "schema_version": { "const": "approved-evidence-search-request.v1" },
    "task_type": { "enum": ["explore", "analyze", "compare", "verify"] },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "cik"],
      "properties": {
        "entity_type": { "const": "company" },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$" }
      }
    },
    "as_of": { "type": "string", "format": "date" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_hash"],
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/query" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "metric", "period_start", "period_end", "unit"],
      "properties": {
        "query_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "unit": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_./-]{0,31}$" }
      }
    }
  }
}
