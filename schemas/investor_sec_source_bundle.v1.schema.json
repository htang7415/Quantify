{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/investor_sec_source_bundle.v1.schema.json",
  "title": "Quantify investor SEC source bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "created_at", "quarters", "manager_ciks", "resources"],
  "properties": {
    "schema_version": { "const": "investor-sec-source-bundle.v1" },
    "source_id": { "const": "sec-edgar-public-filings" },
    "created_at": { "type": "string", "format": "date-time" },
    "quarters": { "type": "integer", "minimum": 2, "maximum": 8 },
    "manager_ciks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{10}$" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "sha256", "media_type"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://(data|www)\\.sec\\.gov/" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_type": { "enum": ["application/json", "application/xml"] }
      }
    }
  }
}
