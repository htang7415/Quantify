{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/approved_calculation_request.v1.schema.json",
  "title": "Quantify approved deterministic calculation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_search_result_hash",
    "release_manifest_hash",
    "calculations"
  ],
  "properties": {
    "schema_version": { "const": "approved-calculation-request.v1" },
    "evidence_search_result_hash": { "$ref": "#/$defs/sha256" },
    "release_manifest_hash": { "$ref": "#/$defs/sha256" },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/instruction" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fact_statement_id": {
      "type": "string",
      "pattern": "^fact-[a-f0-9]{64}$"
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_statement_id",
        "operation",
        "input_statement_ids",
        "decimal_places"
      ],
      "properties": {
        "result_statement_id": {
          "type": "string",
          "pattern": "^calc-[A-Za-z0-9._:-]+$"
        },
        "operation": {
          "enum": ["sum", "difference", "percent_change", "percentage_point_change"]
        },
        "input_statement_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fact_statement_id" }
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    }
  }
}
