{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantify.local/schemas/approved_narrative_context_request.v1.schema.json",
  "title": "Quantify approved narrative context request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_type",
    "entity",
    "as_of",
    "release",
    "filing_accessions",
    "maximum_chunks"
  ],
  "properties": {
    "schema_version": { "const": "approved-narrative-context-request.v1" },
    "task_type": { "enum": ["explore", "analyze", "compare", "verify"] },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "cik"],
      "properties": {
        "entity_type": { "const": "company" },
        "cik": { "type": "string", "pattern": "^[0-9]{10}$" }
      }
    },
    "as_of": { "type": "string", "format": "date" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_hash"],
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "filing_accessions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/accession" }
    },
    "maximum_chunks": { "type": "integer", "minimum": 1, "maximum": 16 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "accession": {
      "type": "string",
      "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
    }
  }
}
