# Reviewable service contract. deploy_staging.sh supplies the concrete values.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: __SERVICE_NAME__
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/maxScale: "2"
        run.googleapis.com/execution-environment: gen2
    spec:
      containerConcurrency: 1
      timeoutSeconds: 10
      serviceAccountName: __RUNTIME_SERVICE_ACCOUNT__
      containers:
        - image: __IMAGE_DIGEST_REF__
          ports:
            - containerPort: 8080
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          env:
            - name: QUANTIFY_IMAGE_DIGEST
              value: __IMAGE_DIGEST__
            - name: GEMINI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: __GEMINI_SECRET_NAME__
                  key: "__GEMINI_SECRET_VERSION__"
