# Copy to a private, ignored file before any authorized staging action.
GCP_PROJECT_ID=replace-with-project-id
GCP_REGION=us-central1
ARTIFACT_REPOSITORY=quantify
IMAGE_NAME=quantify-core-api
SERVICE_NAME=quantify-core-api-staging
RUNTIME_SERVICE_ACCOUNT=quantify-core-runtime@replace-with-project-id.iam.gserviceaccount.com
GEMINI_SECRET_NAME=quantify-gemini-api-key
GEMINI_SECRET_VERSION=1
STAGING_INVOKER_MEMBER=user:replace-with-authorized-caller@example.com

# Set only after Cloud Build has pushed an immutable image.
IMAGE_DIGEST_REF=us-central1-docker.pkg.dev/replace-with-project-id/quantify/quantify-core-api@sha256:replace-with-64-hex-digest
STAGING_TAG=candidate-replace-with-commit-sha
EXPECTED_FIXTURE_MANIFEST_HASH=c604c5c9ccd20d3e06908409ef5193981e4350478b3d38c3517510f390bb55f1
