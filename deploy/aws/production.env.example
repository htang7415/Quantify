# Copy to an ignored private file.  These values prepare two separate stacks:
# an IAM-private production core and a public Cognito-JWT-protected agent edge.
AWS_REGION=us-east-2
PRODUCTION_CORE_STACK_NAME=quantify-production-core
PUBLIC_AGENT_STACK_NAME=quantify-public-agent
WEB_PREVIEW_STACK_NAME=quantify-web-preview

# Build output; never use a mutable image tag for either stack.
IMAGE_URI=123456789012.dkr.ecr.us-east-2.amazonaws.com/quantify-core-api@sha256:replace-with-64-hex-digest
IMAGE_DIGEST=sha256:replace-with-64-hex-digest

# Create a separate production Gemini API key and store it in AWS Secrets Manager.
GEMINI_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:quantify-production-gemini-api-key-replace
GEMINI_SECRET_VERSION_ID=replace-with-immutable-32-to-64-character-version-id

# Existing operator identity, used only for the private core smoke and emergency private access.
SMOKE_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/replace-with-operator
CALLER_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/replace-with-operator
ALARM_EMAIL=operator@example.com

# Start conservatively.  Keep zero until the AWS account supports a reservation.
RESERVED_CONCURRENCY=0
API_THROTTLE_RATE_LIMIT=1
API_THROTTLE_BURST_LIMIT=1
MONTHLY_COST_LIMIT_MICRO_USD=10000000
AUDIT_RETENTION_DAYS=90
LAMBDA_LOG_GROUP_SUFFIX=-v2

# Public edge values.  The domain prefix must be globally unique in its AWS Region.
CORE_API_ID=replace-with-QuantifyApiId-output
CORE_STAGE_NAME=production
COGNITO_DOMAIN_PREFIX=quantify-public-agent-replace-with-unique-suffix
OAUTH_RESOURCE_SERVER_IDENTIFIER=https://api.example.com/quantify
PUBLIC_API_THROTTLE_RATE_LIMIT=1
PUBLIC_API_THROTTLE_BURST_LIMIT=1

# Populate only after the public edge is deployed; never commit the client secret.
PUBLIC_AGENT_URL=https://replace.execute-api.us-east-2.amazonaws.com/production/v1/agent/verify
OAUTH_TOKEN_ENDPOINT=https://replace.auth.us-east-2.amazoncognito.com/oauth2/token
COGNITO_MACHINE_CLIENT_ID=replace-after-public-edge-deploy
COGNITO_MACHINE_CLIENT_SECRET_FILE=/absolute/private/path/quantify-public-client-secret.txt
