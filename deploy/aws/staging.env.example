# Copy to a private, ignored file before any authorized AWS staging action.
AWS_REGION=us-east-2
AWS_STACK_NAME=quantify-private-staging
ECR_REPOSITORY=quantify-core-api
# Zero uses the account's unreserved Lambda pool; set an explicit cap after quota approval.
RESERVED_CONCURRENCY=0
GEMINI_SECRET_NAME=quantify-gemini-api-key
# Private file containing only the Gemini API key; never commit it.
GEMINI_SECRET_FILE=/absolute/private/path/gemini-api-key.txt

# Set after build_image.sh prints the ECR digest-pinned values.
IMAGE_TAG=candidate-replace-with-commit-sha
IMAGE_URI=123456789012.dkr.ecr.us-east-2.amazonaws.com/quantify-core-api@sha256:replace-with-64-hex-digest
IMAGE_DIGEST=sha256:replace-with-64-hex-digest

# IAM user or role ARN allowed only to assume the generated smoke role.
SMOKE_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/replace-with-deployment-identity
# Trusted only to assume the restricted caller role, not to receive its policy directly.
CALLER_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/replace-with-deployment-identity
# Set from provision_staging.sh output; the version ID must remain pinned.
GEMINI_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:quantify-gemini-api-key-replace-with-suffix
GEMINI_SECRET_VERSION_ID=replace-with-immutable-32-to-64-character-version-id

# Confirmation is required after the first deployment before email delivery starts.
ALARM_EMAIL=operator@example.com
# 90 days is the recommended reversible private-staging baseline.
AUDIT_RETENTION_DAYS=90
# Staging-wide token-bucket limits. A bounded request rate also bounds model-call rate.
API_THROTTLE_RATE_LIMIT=2
API_THROTTLE_BURST_LIMIT=2
# $10.00 in micro-USD. It reserves a conservative maximum before each model call.
MONTHLY_COST_LIMIT_MICRO_USD=10000000

# Set after deploy_staging.sh from CloudFormation outputs.
STAGING_URL=https://replace-with-api-id.execute-api.us-east-2.amazonaws.com/staging
SMOKE_ROLE_ARN=arn:aws:iam::123456789012:role/quantify-private-staging-SmokeInvokerRole-replace
# Set from the stack output; use this role for all regular staging requests.
CALLER_ROLE_ARN=arn:aws:iam::123456789012:role/quantify-private-staging-QuantifyCallerRole-replace
EXPECTED_FIXTURE_MANIFEST_HASH=c604c5c9ccd20d3e06908409ef5193981e4350478b3d38c3517510f390bb55f1
EXPECTED_IMAGE_DIGEST=sha256:replace-with-64-hex-digest
