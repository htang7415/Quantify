# Public browser configuration only. Do not put a client secret, AWS credential,
# Gemini credential, private-core URL, or long-lived access token in this file.
VITE_QUANTIFY_AGENT_URL=https://example.execute-api.us-east-2.amazonaws.com/production/v1/agent/verify
# Optional temporary anonymous trial route. It must be time-bounded and server-side capped.
VITE_QUANTIFY_TRIAL_URL=
VITE_COGNITO_DOMAIN=https://example.auth.us-east-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-public-browser-client-id
VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:5173/
VITE_COGNITO_VERIFY_SCOPE=https://api.example.com/quantify/verify
